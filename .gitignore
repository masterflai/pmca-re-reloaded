/build
/dist
*.pyc

# Rust
/target
/crates/pmca-gui/src-tauri/target

# Fuzzing: build output, the growing corpus and crash inputs. A crash input
# worth keeping becomes a unit test in the crate concerned.
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage

# macOS libusb probe: its own workspace, so its build output is ignored the
# same way as the fuzz one.
/macos-libusb-probe/target

# Regenerated by `tauri-build` on every build, as in Tauri's own project
# template. `capabilities/default.json` points its `$schema` here, so an
# editor validates it once the first build has run.
/crates/pmca-gui/src-tauri/gen/schemas

# Editor settings are per person, not per project.
/.vscode/

# Claude Code's per-person permission list. It can record approved commands
# together with the passwords or tokens they contain.
/.claude/settings.local.json

# GUI front-end (produced by `npm install` / `npm run build`)
/crates/pmca-gui/dist
/crates/pmca-gui/node_modules

# Local working files, not part of the project.
/internal/

# Maintainer-side helpers that live beside the project without belonging to it:
# they point at local notes, private remotes or personal redaction lists. Listed
# here rather than in .git/info/exclude, which is not versioned and therefore
# protects only the machine it was written on.
/.github/copilot-instructions.md
/README.proposal.md
/tools/pack-for-transfer.ps1
/tools/redact-hwtest.ps1
/tools/redactions.local.psd1
/tools/rename-workspace.ps1
/tools/sync-memory.ps1
/tools/workshop-check.ps1

# Binary blobs, key files and certificates are never committed. The FDAT files
# under updatershell/bodyfs are the open updater body templates.
*.dat
*.hdr
*.key
# The updater's minisign public key lives in tauri.conf.json; the loose file
# that `tauri signer generate` writes beside the private key is redundant.
updater.key.pub
*.pem
*.p12
*.pfx
*.pmcaplugin
*.fdat
!/updatershell/bodyfs/*.fdat
