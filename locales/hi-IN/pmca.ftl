settings-theme-dark = गहरी

# उन्नत मोड। यह गलती से क्लिक करने से बचाता है, हमलावर से नहीं: जो भी यह खोलता
# है, वह कंसोल से पहले से ही उपलब्ध है।
settings-advanced-heading = उन्नत मोड
settings-advanced-hint = उन्नत मोड सर्विस शेल और अपडेटर शेल पृष्ठों पर दोनों शेल दिखाता है। सर्विस मोड कैमरे की मेमोरी, फ़ाइल सिस्टम और कैलिब्रेशन डेटा तक सीधी पहुँच देता है; गलत लिखा एक कमांड कैमरे को बेकार कर सकता है। जब तक आपको यह पता न हो कि आप क्या लिखने जा रहे हैं, इसे बंद रखें।
settings-advanced-toggle = सर्विस और अपडेटर शेल दिखाएँ
settings-advanced-on = उन्नत मोड चालू है। सर्विस शेल और अपडेटर शेल पृष्ठ अब शेल स्वयं दिखाते हैं।
settings-advanced-off = उन्नत मोड बंद है। सर्विस शेल और अपडेटर शेल पृष्ठ इसके बजाय कंसोल का रास्ता समझाते हैं।
settings-advanced-confirm = सर्विस और अपडेटर शेल आपके कैमरे को स्थायी रूप से क्षति पहुँचा सकते हैं। क्या दोनों शेल दिखाएँ?
settings-update-heading = अपडेट सूचना
settings-update-purpose = चालू होने पर प्रोग्राम हर बार शुरू होते समय GitHub से पूछता है कि कोई नया संस्करण जारी हुआ है या नहीं, और यदि हुआ है तो विंडो के ऊपर बताता है। इस दौरान GitHub आपका IP पता जान लेता है; इसके अलावा कुछ नहीं भेजा जाता। प्री-रिलीज़ संस्करणों की सूचना नहीं दी जाती।
settings-update-toggle = शुरू होने पर नया संस्करण उपलब्ध होने की सूचना दें
settings-update-on = अपडेट सूचना चालू है। अगली बार शुरू होने से नया संस्करण विंडो के ऊपर दिखाया जाएगा।
settings-update-off = अपडेट सूचना बंद है। प्रोग्राम नए संस्करण नहीं खोजता।
update-available = नया संस्करण उपलब्ध है
update-current = स्थापित संस्करण
update-latest = नया संस्करण
btn-update-dismiss = छिपाएँ

# अनुवाद का संपादन। भाषा फ़ाइलें डाउनलोड करके किसी भी टेक्स्ट एडिटर में
# बदली और फिर अपलोड की जा सकती हैं; अपलोड की गई फ़ाइल उपयोग से पहले जाँची जाती है।
settings-catalog-heading = अनुवाद संपादित करें
settings-catalog-hint = भाषा फ़ाइल डाउनलोड करें, अपनी पसंद के टेक्स्ट एडिटर में बदलें और फिर अपलोड करें। केवल बराबर के चिन्ह के दाएँ का पाठ अनुवादित होता है, और छोड़ी गई प्रविष्टियाँ अपना अंतर्निहित पाठ बनाए रखती हैं। यहाँ चुनी गई भाषा से ऐप्लिकेशन की भाषा नहीं बदलती।
settings-catalog-locale = भाषा फ़ाइल
settings-catalog-builtin = अंतर्निहित अनुवाद उपयोग में है।
settings-catalog-custom = आपका अपना अनुवाद उपयोग में है:
btn-catalog-export = डाउनलोड…
btn-catalog-import = अपलोड…
btn-catalog-reset = अंतर्निहित पुनः लाएँ
catalog-exported = यहाँ लिखा गया
catalog-imported = अनुवाद लागू कर दिया गया।
catalog-reset-done = अंतर्निहित अनुवाद पुनः लागू कर दिया गया।
catalog-reset-none = पुनः लाने के लिए कोई अपना अनुवाद नहीं था।
catalog-reset-confirm = इस भाषा के लिए अपना अनुवाद हटाएँ?
catalog-rejected = फ़ाइल लागू नहीं की गई। कृपया ये पंक्तियाँ ठीक करें:
catalog-count-accepted = लागू प्रविष्टियाँ
catalog-count-missing = अंतर्निहित अनुवाद से बनाई रखी गई प्रविष्टियाँ
catalog-count-untranslated = अंग्रेज़ी मूल के समान प्रविष्टियाँ
catalog-line = पंक्ति
catalog-problem-syntax = “id = पाठ” रूप की प्रविष्टि नहीं है
catalog-problem-continuation = अगली पंक्ति में जारी है, जो समर्थित नहीं है
catalog-problem-duplicate = एक से अधिक बार परिभाषित है
catalog-problem-unknown-key = यह प्रविष्टि इस ऐप्लिकेशन में उपयोग नहीं होती
catalog-problem-empty = इसमें कोई पाठ नहीं है
catalog-problem-placeholder = प्लेसहोल्डर बदल गया, अपेक्षित:

# उत्पत्ति, आभार और लाइसेंस। लाइसेंस पृष्ठ पर और `pmca-console license` द्वारा
# दिखाया जाता है। लाइसेंस का पाठ स्वयं अनुवादित नहीं है: वह एक कानूनी दस्तावेज़ है
# और उसे अक्षरशः पुन: प्रस्तुत किया गया है।
about-thanks-heading = आभार
about-thanks-body-1 = यह टूल ma1co की वजह से मौजूद है, जिन्होंने पता लगाया कि Sony के कैमरे USB पर कैसे संवाद करते हैं और जिन्होंने 2015 में Sony-PMCA-RE जारी किया, और उन सभी की वजह से जिन्होंने उसके बाद के वर्षों में उसमें तथा OpenMemories परियोजनाओं में योगदान दिया।
about-thanks-body-2 = कैमरा पहचान, बाहरी कमांड प्रोटोकॉल, फ़र्मवेयर अपडेटर प्रक्रिया और सर्विस मोड — यह सब उन्हीं का काम है, और यह पोर्ट उस काम को आगे बढ़ाता है। धन्यवाद। इसी नींव पर PMCA-RE RELOADED कई नई सुविधाएँ जोड़ता है, जो masterflai ने प्रदान की हैं। इनमें सबसे प्रमुख है Windows पर डिवाइस ड्राइवर का अब अंतर्निहित स्वचालित बदलाव: कैमरे को किसी अलग टूल से हाथ से दूसरा ड्राइवर सौंपने की ज़रूरत अब नहीं रही, जिससे यह प्रक्रिया अधिक सुविधाजनक, तेज़ और कम जोखिम भरी हो गई है।
about-contributors-heading = योगदानकर्ता
about-contributors-body = ma1co के अलावा इन लोगों ने Sony-PMCA-RE में योगदान दिया, या अपनी प्रतियों में ऐसे बदलाव प्रकाशित किए जो इस पोर्ट में लिए गए हैं:
about-purpose-heading = यह पोर्ट क्यों है
about-purpose-body-1 = मूल ऐप्लिकेशन का विकास अब नहीं हो रहा है। वह Python 2 के लिए लिखा गया था, जिसका जीवनकाल 2020 में समाप्त हो गया, और उसके कुछ हिस्से उन सेवाओं पर निर्भर हैं जिन्हें Sony तब से बंद कर चुका है, इसलिए वह मौजूदा सिस्टमों पर बिना पाबंदियों के नहीं चलता।
about-purpose-body-2 = इस पोर्ट का उद्देश्य प्रतिस्थापन नहीं, बल्कि संरक्षण है, और उतना ही आज बिना परेशानी के उपयोग भी: इन कैमरों को उपयोग योग्य बनाए रखना, और प्रोग्राम को आज के कंप्यूटरों पर तथा नए कैमरा मॉडलों के साथ भी बिना कठिनाई के चलाना। मूल जो कुछ कर सकता था, यह भी वह सब कर सके।
about-origin-heading = यह कैसे बना
about-origin-body-1 = Python से Rust में पोर्ट AI की मदद से किया गया।
about-origin-body-2 = इसका क्या अर्थ नहीं है, यह भी उतनी ही स्पष्टता से कहना ज़रूरी है: व्यवहार एक स्वचालित परीक्षण सूट और एक हार्डवेयर परीक्षण योजना से जाँचा गया है। विशेष रूप से Windows संस्करण की गहन जाँच की गई है, क्योंकि डिवाइस ड्राइवर उसे सबसे जटिल प्लेटफ़ॉर्म बनाते हैं; वहीं macOS और Linux का पूर्ण परीक्षण नहीं हो सका। कृपया इसे प्रयोगात्मक सॉफ़्टवेयर मानें।
about-license-heading = लाइसेंस
about-license-body = यह पोर्ट MIT लाइसेंस के अंतर्गत प्रकाशित है, वही लाइसेंस जो मूल परियोजना का है। मूल कॉपीराइट सूचना अपरिवर्तित रखी गई है, जैसा वह लाइसेंस अपेक्षित करता है।
about-license-full = लाइसेंस का पाठ
about-third-party-heading = उपयोग की गई लाइब्रेरियों के लाइसेंस
about-third-party-body = यह प्रोग्राम स्थैतिक रूप से लिंक किया गया है: जिन लाइब्रेरियों का यह उपयोग करता है उनका कोड निष्पादन योग्य फ़ाइल के भीतर ही है, और उनके लाइसेंस यह अपेक्षा करते हैं कि कॉपीराइट सूचनाएँ उसके साथ ही रहें। वे नीचे पूरी तरह दी गई हैं, प्रति पैकेज एक प्रविष्टि।
about-third-party-toggle = सभी तृतीय-पक्ष सूचनाएँ दिखाएँ
about-privacy-heading = डेटा
about-privacy-body-1 = यह प्रोग्राम आपके अपने कंप्यूटर पर चलता है। यह उपयोग-संबंधी कोई डेटा नहीं भेजता, इसमें कोई टेलीमेट्री नहीं है और न ही किसी खाते की आवश्यकता है। आप यहाँ जो कुछ भी करते हैं, उसकी सूचना कहीं नहीं जाती।
about-privacy-body-2 = फिर भी दो सुविधाएँ स्वयं नेटवर्क से जुड़ती हैं, और तब दूसरा पक्ष आपका IP पता जान लेता है: GPS सहायक डेटा Sony से डाउनलोड होता है, और आपके जोड़े गए स्रोत GitHub से पढ़े जाते हैं, उनके स्टार के साथ और, आपके कहने पर, वहाँ एक खोज के साथ; ऐप और प्लगइन उन पतों से डाउनलोड होते हैं जो ये स्रोत बताते हैं। इन सुविधाओं के बिना यह प्रोग्राम पूरी तरह ऑफ़लाइन रहता है। यदि आप सेटिंग्स में अपडेट सूचना चालू करते हैं, तो प्रोग्राम हर बार शुरू होने पर GitHub से नवीनतम संस्करण के बारे में भी पूछता है।
about-privacy-body-3 = कैमरे से जो पढ़ा जाता है — जिसमें उसका सीरियल नंबर और सहेजे गए Wi-Fi पासवर्ड भी शामिल हैं — वह आपके कंप्यूटर से बाहर नहीं जाता। यदि आप उसे किसी फ़ाइल में लिखते हैं, तो ध्यान रखें कि वह फ़ाइल आप किसे देते हैं।
about-privacy-body-4 = इस प्रोग्राम के पीछे कोई सेवा नहीं चलाई जाती और इसके रचयिताओं तक कोई डेटा नहीं पहुँचता, इसलिए यहाँ न कुछ माँगने को है और न मिटवाने को। ऊपर बताई गई दोनों सेवाएँ अपने देखे हुए पतों के साथ क्या करती हैं, यह उनकी अपनी गोपनीयता नीतियों पर निर्भर है, इस कथन पर नहीं।
about-legal-heading = कानूनी सूचनाएँ
about-legal-trademark = यह एक स्वतंत्र परियोजना है। यह न तो Sony द्वारा बनाई गई है, न ही उसके द्वारा अनुमोदित है, और न ही किसी रूप में उससे जुड़ी है। "Sony", "PlayMemories" तथा कैमरा मॉडलों के नाम Sony Group Corporation के ट्रेडमार्क हैं, जिनका उल्लेख यहाँ केवल यह बताने के लिए किया गया है कि यह उपकरण किन कैमरों से संवाद करता है।
about-legal-own-device = यह प्रोग्राम आपके अपने कैमरों के साथ उपयोग के लिए है।
about-legal-warranty = यह उपकरण जो करता है वह उससे परे है जो Sony ने इन कैमरों के लिए सोचा है, और ऐसा करने से आपकी वारंटी समाप्त हो सकती है। सॉफ़्टवेयर स्वयं बिना किसी वारंटी के दिया जाता है और इसका उपयोग आपके अपने जोखिम पर है। अपने ही उपकरण की रिवर्स इंजीनियरिंग कहाँ तक अनुमत है, यह देश पर निर्भर करता है।
