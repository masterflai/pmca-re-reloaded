# Backup image dump and comparison.
nav-compare = Cameravergelijking
nav-pin = Navigatie vastmaken
nav-unpin = Navigatie losmaken
nav-expand = Navigatie uitklappen
nav-camera-none = Geen camera
nav-camera-waiting = Camera niet gereed
