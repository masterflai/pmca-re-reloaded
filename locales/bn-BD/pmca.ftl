# ফাইল ডায়ালগের ফাইল-ধরন ফিল্টার
file-filter-apk = অ্যান্ড্রয়েড অ্যাপ্লিকেশন (*.apk)
file-filter-firmware = Sony ফার্মওয়্যার ইমেজ (*.dat)
file-filter-usage-log = ব্যবহার লগ (*.bin)
file-filter-catalog = অনুবাদ ফাইল (*.ftl)
file-filter-spk = সনি অ্যাপ প্যাকেজ (*.spk)
